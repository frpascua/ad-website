# JWT Secret (genera una clave segura aleatoria)
JWT_SECRET=tu-clave-secreta-muy-larga-y-aleatoria-aqui

# Resend API Key (obtén en https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# URL base de tu aplicación (en producción será tu dominio de Vercel)
BASE_URL=https://tu-dominio.vercel.app

# Email remitente (debe estar verificado en Resend)
FROM_EMAIL=login@tudominio.com
