# ============================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ============================================
# 
# IMPORTANTE: Este archivo es un ejemplo.
# Copia este archivo como .env y cambia los valores.
# NO subas el archivo .env a Git (ya está en .gitignore)

# Clave secreta para firmar los JWT
# OBLIGATORIO cambiar en producción por una cadena larga y aleatoria
JWT_SECRET=tu-super-secreto-cambiar-en-produccion-123456

# Puerto del servidor en desarrollo local (opcional)
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=development

# ============================================
# CONFIGURACIÓN DE EMAIL CON RESEND
# ============================================

# API Key de Resend (https://resend.com/api-keys)
# OBLIGATORIO para enviar emails en producción
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email del remitente (debe estar verificado en Resend)
# Para desarrollo puedes usar: onboarding@resend.dev
# Para producción: tu-email@tu-dominio.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Ejemplo con SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ejemplo con Mailgun (https://mailgun.com)
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.tu-dominio.com

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS (Opcional)
# ============================================

# PostgreSQL
# DATABASE_URL=postgresql://usuario:password@localhost:5432/mi_base_datos

# MongoDB
# MONGODB_URI=mongodb://localhost:27017/mi_base_datos

# ============================================
# NOTAS
# ============================================
#
# Generar una clave JWT segura (PowerShell):
# -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
#
# En Vercel, configura las variables de entorno en:
# Dashboard → Tu Proyecto → Settings → Environment Variables
