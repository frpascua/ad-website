# Variables de entorno para Clerk

# Obtén estas credenciales desde el dashboard de Clerk
# https://dashboard.clerk.com

# Clave pública de Clerk (segura para usar en el frontend)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend API de Clerk (ejemplo: clerk.amazing-app-12.lcl.dev)
CLERK_FRONTEND_API=clerk.your-app.lcl.dev

# NOTA: Nunca incluyas tu Secret Key en código del lado del cliente
# La Secret Key solo debe usarse en el backend
